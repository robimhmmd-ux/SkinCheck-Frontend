# SkinCheck Frontend — salin file ini menjadi .env.local, lalu isi sendiri.
# JANGAN isi URL backend asli di repo ini; file .env.local sudah di-gitignore.
# NEXT_PUBLIC_API_URL: URL dasar backend Python (FastAPI) — TANPA trailing slash.
# Contoh format (ganti dengan URL backend kamu sendiri):
# NEXT_PUBLIC_API_URL=https://backend-kamu.example.com
NEXT_PUBLIC_API_URL=
# BACKEND_URL: opsional, hanya untuk pemanggilan server-side di masa depan.
BACKEND_URL=
